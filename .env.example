# Скопируй в .env и заполни
BOT_TOKEN=123456:ABC-DEF...
# ID администраторов через запятую (свой узнать у @userinfobot)
ADMIN_IDS=123456789
# Реквизиты для ручной оплаты (v1)
PAYMENT_DETAILS=Карта 0000 0000 0000 0000 (Тинькофф, Иван И.)
# Строка подключения к БД
DB_URL=sqlite+aiosqlite:///shop.db
# Какую витрину залить в ПУСТУЮ базу: shop (с мемными отсылками) | plain (нейтральная)
# Уже заполненную базу не трогает — для смены удали .db и перезапусти.
SEED=shop
# Валюта витрины: USD | EUR | GBP | RUB | KZT
CURRENCY=USD

# --- Витрина Mini App ---
# Публичный HTTPS-адрес витрины. Локально — адрес туннеля, в проде — домен.
# На Render можно не задавать: подставится RENDER_EXTERNAL_URL.
# Пусто и вне хостинга — бот работает без кнопки витрины.
WEBAPP_URL=
# Порт локального сервера. На хостинге вместо него приходит PORT.
WEB_PORT=8080

# --- Только для хостинга ---
# Webhook вместо long-polling. Обязателен там, где контейнер засыпает без
# входящих запросов: спящий polling перестаёт забирать апдейты, webhook будит.
USE_WEBHOOK=false
# Приложение за обратным прокси: разрешает верить заголовку с реальным IP
# (иначе все посетители делят один лимит частоты) и слушать 0.0.0.0.
TRUST_PROXY=false

# Стоимость доставки в валюте магазина (самовывоз всегда бесплатный)
DELIVERY_COURIER=9
DELIVERY_POST=15

# --- ИИ-консультант (опционально) ---
# Пусто — консультанта нет. gigachat — российский API, оплата в рублях,
# физлицу год бесплатных токенов: developers.sber.ru/docs/ru/gigachat/quickstart/main
AI_PROVIDER=
# Ключ авторизации из личного кабинета GigaChat (не access token — его SDK берёт сам)
GIGACHAT_CREDENTIALS=
GIGACHAT_MODEL=GigaChat-2
# Проверка TLS: на сервере поставить сертификат НУЦ Минцифры (gosuslugi.ru/crt),
# false — только локально для отладки
GIGACHAT_VERIFY_SSL=true
# Сколько вопросов консультанту может задать один человек. Защита кошелька и
# квоты ключа, не UX: живой покупатель в эти рамки не упирается. 0 — без лимита.
AI_MAX_PER_MINUTE=8
AI_MAX_PER_DAY=80
# Название магазина в ответах консультанта и в тексте «О магазине»
SHOP_NAME=Watch Demo
