# Скопируй в deploy/.env на сервере и заполни.
# Домен, A-запись которого смотрит на IP сервера. Caddy выпустит сертификат сам.
DOMAIN=shop.example.ru
# Пароль базы: любая длинная случайная строка, наружу база не открыта.
POSTGRES_PASSWORD=

BOT_TOKEN=
ADMIN_IDS=
PAYMENT_DETAILS=
SHOP_NAME=Watch Demo
SEED=shop
CURRENCY=RUB
DEMO_REVIEWS=false
PICKUP_ADDRESS=
PICKUP_HOURS=

# ИИ-консультант: из РФ — gigachat, Gemini без VPN не ответит.
AI_PROVIDER=
GIGACHAT_CREDENTIALS=

# Заявки с лендингов, домены через запятую. Пусто — выключено.
LEAD_ORIGINS=
